# ─────────────────────────────────────────────
# Salesforce Autonomous Browser Agent — .env
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# ── Salesforce credentials ───────────────────
SALESFORCE_URL=https://trailhead.salesforce.com
SALESFORCE_USER=your_trailhead_email@example.com
SALESFORCE_PASS=your_trailhead_password

# Optional: Developer Edition org (if separate)
SALESFORCE_DEV_URL=https://login.salesforce.com
SALESFORCE_DEV_USER=your_dev_email@example.com
SALESFORCE_DEV_PASS=your_dev_password

# ── LLM / Reasoning ──────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Agent behaviour ───────────────────────────
AUTONOMOUS_MODE=true
HEADLESS=false
MAX_RETRIES=3
ACTION_TIMEOUT_MS=15000
NAVIGATION_TIMEOUT_MS=30000

# ── Observability ────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
TRACE_TO_CONSOLE=true

# ── Memory ───────────────────────────────────
MEMORY_DB_PATH=memory.db
